{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
            "id": "buildType",
            "type": "pickString",
            "description": "Select build type",
            "options": [
                "Release",
                "Debug"
            ],
            "default": "Release"
        }
    ],
    "configurations": [
        {
            "name": "Run all tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "ctest . --output-on-failure",
            "args": [],
            "cwd": "${workspaceFolder}\\out\\build\\${input:buildType}\\",
            "preLaunchTask": "CMake: Run Tests"
        }
    ]
}
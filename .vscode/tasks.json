{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "buildType",
			"type": "pickString",
			"description": "Select build type",
			"options": [
				"Release",
				"Debug"
			],
			"default": "Release"
		}
	],
	"tasks": [
		{
			"label": "CMake: Configure",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-D CMAKE_BUILD_TYPE=${input:buildType}",
				"-D CMAKE_EXPORT_COMPILE_COMMANDS=ON",
				"-D ENABLE_ALL_TESTS=ON",
				"-S .",
				"-B out/build/${input:buildType}"
			],
			"dependsOn": [],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"detail": "Configure CMake with all tests enabled"
		},
		{
			"label": "CMake: Build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build", "out/build/${input:buildType}",
				"--config", "${input:buildType}"
			],
			"dependsOn": ["CMake: Configure"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Build the project using CMake"
		},
		{
			"label": "CMake: Clean",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build", "out/build/${input:buildType}",
				"--target", "clean"
			],
			"dependsOn": [],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"detail": "Clean the build using CMake"
		},
		{
			"label": "CMake: Run Tests",
			"type": "shell",
			"command": "ctest",
			"args": [
				"--output-on-failure",
				"--test-dir out/build/${input:buildType}",
				"-C ${input:buildType}"
			],
			"dependsOn": ["CMake: Build"],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"detail": "Run all tests using CTest"
		}
	]
}
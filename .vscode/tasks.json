{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "buildType",
			"type": "pickString",
			"description": "Select build type",
			"options": [
				"Release",
				"Debug"
			],
			"default": "Release"
		}
	],
	"tasks": [
		{
			"label": "Clean Build",
			"type": "shell",
			"command": "bash",
			"args": ["-c", "rm -rf build"],
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"detail": "Clean the build directory"
		},
		{
			"label": "CMake: Configure",
			"type": "shell",
			"command": "bash",
			"args": ["-c", "mkdir -p build && cd build && cmake -D CMAKE_BUILD_TYPE=${input:buildType} -D ENABLE_ALL_TESTS=ON .."],
			"dependsOn": ["Clean Build"],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"detail": "Configure CMake with all tests enabled"
		},
		{
			"label": "CMake: Build",
			"type": "shell",
			"command": "bash",
			"args": ["-c", "cd build && cmake --build . --config ${input:buildType}"],
			"dependsOn": ["CMake: Configure"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Build the project using CMake"
		}
	]
}